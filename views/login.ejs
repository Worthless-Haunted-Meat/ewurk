<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in — EWURK</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/nav', { user: null }) %>
  <main>
    <h1>EWURK</h1>
    <p>Electronic Waste Urban Renewal Kit</p>
    <% if (mailError) { %>
      <div role="alert">Outbound email is not configured. Contact your administrator.</div>
    <% } else if (sent) { %>
      <div role="status">Check the sign-in outbox for your link.</div>
    <% } %>
    <form method="post" action="/auth/magic-link">
      <label for="email">Work email</label>
      <input type="email" id="email" name="email" required autocomplete="email">
      <button type="submit">Send sign-in link</button>
    </form>
  </main>
</body>
</html>
