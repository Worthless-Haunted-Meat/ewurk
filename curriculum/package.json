{
  "name": "ewurk-curriculum",
  "version": "0.1.0",
  "private": true,
  "description": "Saturday class lesson content for the EWURK Linux lease program (attendance stays in EWURK).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "eslint": "^9.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  }
}
