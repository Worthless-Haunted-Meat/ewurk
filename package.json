{
  "name": "ewurk",
  "version": "0.1.0",
  "private": true,
  "description": "EWURK - Electronic Waste Urban Renewal Kit: donation intake, device lifecycle, leases, payments, and class attendance for a refurbished-laptop lease program.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').mkdirSync('dist/db',{recursive:true});require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e:reset": "node -e \"try{require('fs').unlinkSync('data/test.db')}catch(e){}\"",
    "test:e2e:seed": "EWURK_DB_PATH=data/test.db tsx src/seed.ts",
    "test:e2e:serve": "EWURK_DB_PATH=data/test.db PORT=4310 node dist/server.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.47.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "eslint": "^9.10.0",
    "railway": "^3.11.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  }
}
